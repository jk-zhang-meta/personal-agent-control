{
  "schemaVersion": 1,
  "providers": [
    {
      "name": "codegraph",
      "kind": "mcp-server",
      "versionPolicy": "pinned",
      "version": "1.5.0",
      "command": "mise",
      "args": ["--cd", "{{PAC_ROOT}}", "exec", "--", "codegraph", "serve", "--mcp"],
      "hosts": {
        "codex": {
          "config": ".codex/config.toml",
          "format": "codex-toml"
        },
        "claude": {
          "config": ".claude.json",
          "format": "claude-json"
        }
      }
    }
  ]
}
