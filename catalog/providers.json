{
  "schemaVersion": 1,
  "providers": [
    {
      "name": "codegraph",
      "kind": "mcp-server",
      "versionPolicy": "pinned",
      "version": "1.6.0",
      "versionCommand": "codegraph",
      "command": "mise",
      "args": ["--cd", "{{PAC_ROOT}}", "exec", "--", "codegraph", "serve", "--mcp", "--no-watch"],
      "hosts": {
        "codex": {
          "config": ".codex/config.toml",
          "format": "codex-toml"
        },
        "claude": {
          "config": ".claude.json",
          "format": "claude-json"
        }
      },
      "clients": {
        "agy": {
          "config": ".gemini/config/mcp_config.json",
          "format": "agy-json"
        },
        "grok": {
          "config": ".grok/config.toml",
          "format": "grok-toml"
        }
      }
    },
    {
      "name": "playwright",
      "kind": "mcp-server",
      "versionPolicy": "pinned",
      "version": "0.0.83",
      "versionCommand": "playwright-mcp",
      "command": "mise",
      "args": ["--cd", "{{PAC_ROOT}}", "exec", "--", "playwright-mcp", "--browser", "chrome", "--headless", "--isolated", "--output-dir", "{{PAC_HOME}}/.agent-work/browser-automation/mcp"],
      "hosts": {
        "codex": {
          "config": ".codex/config.toml",
          "format": "codex-toml"
        },
        "claude": {
          "config": ".claude.json",
          "format": "claude-json"
        }
      },
      "clients": {
        "agy": {
          "config": ".gemini/config/mcp_config.json",
          "format": "agy-json"
        },
        "grok": {
          "config": ".grok/config.toml",
          "format": "grok-toml"
        }
      }
    }
  ]
}
